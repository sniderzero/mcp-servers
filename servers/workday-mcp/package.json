{
  "name": "workday-mcp",
  "version": "1.0.0",
  "description": "Workday MCP server — Financial, Procurement, HCM, Projects, Reporting",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "node build.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run bundle && npm run package:mac-arm64 && npm run package:win",
    "package:mac-arm64": "npx @yao-pkg/pkg dist/workday-mcp.cjs -t node20-macos-arm64 -o release/workday-mcp-macos-arm64 --compress GZip",
    "package:win": "npx @yao-pkg/pkg dist/workday-mcp.cjs -t node20-win-x64 -o release/workday-mcp-win-x64.exe --compress GZip"
  },
  "pkg": {
    "targets": [
      "node20-macos-arm64",
      "node20-win-x64"
    ],
    "outputPath": "release"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.7",
    "open": "^10.1.0",
    "soap": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@yao-pkg/pkg": "^6.14.2",
    "esbuild": "^0.24.0",
    "typescript": "~5.7.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
