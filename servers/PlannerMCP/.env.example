# Required — from your Azure App Registration
TENANT_ID=your-tenant-id
CLIENT_ID=your-app-client-id

# Optional — pin a specific Dataverse environment URL (Planner Premium)
# If not set, the first active environment is discovered automatically.
# Run dv_discover_environments to find your ApiUrl.
# DATAVERSE_URL=https://yourorg.api.crm.dynamics.com

# Optional
TOKEN_CACHE_PATH=~/.planner-mcp/token-cache.json
