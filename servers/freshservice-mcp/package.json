{
  "name": "freshservice-mcp",
  "version": "1.0.0",
  "description": "MCP server for FreshService API v2 - complete coverage",
  "type": "module",
  "bin": {
    "freshservice-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "bundle": "esbuild build/index.js --bundle --platform=node --target=node20 --format=cjs --outfile=bundle.cjs",
    "package": "npm run build && npm run bundle && npm run package:mac-arm64 && npm run package:win",
    "package:mac-arm64": "npx @yao-pkg/pkg bundle.cjs -t node20-macos-arm64 -o release/freshservice-itsm-macos-arm64 --compress GZip",
    "package:win": "npx @yao-pkg/pkg bundle.cjs -t node20-win-x64 -o release/freshservice-itsm-win-x64.exe --compress GZip"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@yao-pkg/pkg": "^6.14.2",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0"
  },
  "pkg": {
    "targets": [
      "node20-macos-arm64",
      "node20-win-x64"
    ],
    "outputPath": "release"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
