[
  {
    "id": "teams-list-joined",
    "description": "List all teams the current user has joined",
    "examples": [
      "What teams am I in?",
      "List my teams",
      "Show me all my joined teams"
    ],
    "service": "teams",
    "endpoint": "/me/joinedTeams",
    "method": "GET",
    "scopes": ["Team.ReadBasic.All"],
    "query_params": {
      "$select": "id,displayName,description",
      "$top": 50
    },
    "tags": ["teams", "list", "membership"]
  },
  {
    "id": "teams-get-team",
    "description": "Get details of a specific team by its ID",
    "examples": [
      "Get info about team {id}",
      "Show me team details",
      "What is the description of team X?"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}",
    "method": "GET",
    "scopes": ["Team.ReadBasic.All"],
    "tags": ["teams", "get", "details"]
  },
  {
    "id": "teams-list-members",
    "description": "List all members of a specific team",
    "examples": [
      "Who is in team X?",
      "List team members",
      "Show members of the engineering team"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/members",
    "method": "GET",
    "scopes": ["TeamMember.Read.All"],
    "tags": ["teams", "members", "list"]
  },
  {
    "id": "teams-get-member",
    "description": "Get details about a specific team member",
    "examples": [
      "Get member info for user X in team Y",
      "What role does this person have in the team?"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/members/{membership-id}",
    "method": "GET",
    "scopes": ["TeamMember.Read.All"],
    "tags": ["teams", "members", "get"]
  },
  {
    "id": "teams-list-channels",
    "description": "List all channels in a team",
    "examples": [
      "What channels are in team X?",
      "List channels for the marketing team",
      "Show me all channels"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels",
    "method": "GET",
    "scopes": ["Channel.ReadBasic.All"],
    "query_params": {
      "$select": "id,displayName,description,membershipType"
    },
    "tags": ["teams", "channels", "list"]
  },
  {
    "id": "teams-get-channel",
    "description": "Get details of a specific channel in a team",
    "examples": [
      "Get info about channel X in team Y",
      "Show channel details"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels/{channel-id}",
    "method": "GET",
    "scopes": ["Channel.ReadBasic.All"],
    "tags": ["teams", "channels", "get"]
  },
  {
    "id": "teams-create-channel",
    "description": "Create a new channel in a team",
    "examples": [
      "Create a channel called 'Project Updates' in team X",
      "Add a new private channel to the team",
      "Make a new channel for the sprint"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels",
    "method": "POST",
    "scopes": ["Channel.Create"],
    "body_template": {
      "displayName": "{{channelName}}",
      "description": "{{description}}",
      "membershipType": "standard"
    },
    "notes": "membershipType can be 'standard', 'private', or 'shared'. Private channels require additional owner setup.",
    "tags": ["teams", "channels", "create"]
  },
  {
    "id": "teams-delete-channel",
    "description": "Delete a channel from a team",
    "examples": [
      "Delete channel X from team Y",
      "Remove the old project channel"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels/{channel-id}",
    "method": "DELETE",
    "scopes": ["Channel.Delete.All"],
    "notes": "The General channel cannot be deleted. Deleted channels can be recovered within 21 days.",
    "tags": ["teams", "channels", "delete"]
  },
  {
    "id": "teams-list-channel-messages",
    "description": "List messages in a channel with pagination support",
    "examples": [
      "Show recent messages in channel X",
      "What are the latest messages in the General channel?",
      "Get messages from the announcements channel"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels/{channel-id}/messages",
    "method": "GET",
    "scopes": ["ChannelMessage.Read.All"],
    "query_params": {
      "$top": 20
    },
    "notes": "ChannelMessage.Read.All may require admin consent in some tenants. Use $top for pagination and follow @odata.nextLink for more results.",
    "tags": ["teams", "channels", "messages", "list", "pagination"]
  },
  {
    "id": "teams-get-channel-message",
    "description": "Get a specific message from a channel",
    "examples": [
      "Get message details for message X in channel Y",
      "Show me that specific channel message"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels/{channel-id}/messages/{message-id}",
    "method": "GET",
    "scopes": ["ChannelMessage.Read.All"],
    "notes": "ChannelMessage.Read.All may require admin consent in some tenants.",
    "tags": ["teams", "channels", "messages", "get"]
  },
  {
    "id": "teams-list-channel-message-replies",
    "description": "List replies to a specific channel message",
    "examples": [
      "Show replies to message X",
      "What are the replies in that thread?",
      "Get the conversation thread"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels/{channel-id}/messages/{message-id}/replies",
    "method": "GET",
    "scopes": ["ChannelMessage.Read.All"],
    "notes": "ChannelMessage.Read.All may require admin consent in some tenants.",
    "tags": ["teams", "channels", "messages", "replies", "list"]
  },
  {
    "id": "teams-send-channel-message",
    "description": "Send a new message to a channel",
    "examples": [
      "Post a message in channel X",
      "Send 'Hello team' to the General channel",
      "Write a message in the announcements channel"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels/{channel-id}/messages",
    "method": "POST",
    "scopes": ["ChannelMessage.Send"],
    "body_template": {
      "body": {
        "contentType": "html",
        "content": "{{messageContent}}"
      }
    },
    "notes": "contentType can be 'text' or 'html'. Use html for rich formatting.",
    "tags": ["teams", "channels", "messages", "send", "create"]
  },
  {
    "id": "teams-reply-channel-message",
    "description": "Send a reply to a specific channel message",
    "examples": [
      "Reply to message X in channel Y",
      "Respond to that thread",
      "Add a reply to the conversation"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels/{channel-id}/messages/{message-id}/replies",
    "method": "POST",
    "scopes": ["ChannelMessage.Send"],
    "body_template": {
      "body": {
        "contentType": "html",
        "content": "{{replyContent}}"
      }
    },
    "tags": ["teams", "channels", "messages", "replies", "send"]
  },
  {
    "id": "teams-list-my-chats",
    "description": "List all chats for the current user",
    "examples": [
      "Show my chats",
      "List my recent conversations",
      "What chats do I have?"
    ],
    "service": "teams",
    "endpoint": "/me/chats",
    "method": "GET",
    "scopes": ["Chat.ReadBasic", "Chat.Read"],
    "query_params": {
      "$top": 50,
      "$orderby": "lastMessagePreview/createdDateTime desc"
    },
    "tags": ["teams", "chats", "list"]
  },
  {
    "id": "teams-list-one-on-one-chats",
    "description": "List one-on-one chats for the current user",
    "examples": [
      "Show my direct messages",
      "List my 1:1 chats",
      "Show my one-on-one conversations"
    ],
    "service": "teams",
    "endpoint": "/me/chats",
    "method": "GET",
    "scopes": ["Chat.ReadBasic", "Chat.Read"],
    "query_params": {
      "$filter": "chatType eq 'oneOnOne'",
      "$top": 50
    },
    "tags": ["teams", "chats", "list", "one-on-one", "direct-message"]
  },
