    ],
    "service": "teams",
    "endpoint": "/me/chats",
    "method": "GET",
    "scopes": ["Chat.ReadBasic", "Chat.Read"],
    "query_params": {
      "$filter": "chatType eq 'group'",
      "$top": 50
    },
    "tags": ["teams", "chats", "list", "group"]
  },
  {
