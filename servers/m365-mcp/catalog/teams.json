      "Get chat history"
    ],
    "service": "teams",
    "endpoint": "/me/chats/{chat-id}/messages",
    "method": "GET",
    "scopes": ["Chat.Read"],
    "query_params": {
      "$top": 20
    },
    "notes": "Chat messages use /me/chats/{id}/messages -- the chat ID is required. Use $top for pagination and follow @odata.nextLink for more results.",
    "tags": ["teams", "chats", "messages", "list", "pagination"]
  },
  {
    "id": "teams-send-chat-message",
    "description": "Send a message in a specific chat",
    "examples": [
      "Send a message in chat X",
      "Message John in our 1:1 chat",
      "Reply in the group chat"
    ],
    "service": "teams",
    "endpoint": "/me/chats/{chat-id}/messages",
    "method": "POST",
    "scopes": ["Chat.ReadWrite"],
    "body_template": {
      "body": {
        "contentType": "html",
        "content": "{{messageContent}}"
      }
    },
    "notes": "Chat messages use /me/chats/{id}/messages -- the chat ID is required.",
    "tags": ["teams", "chats", "messages", "send", "create"]
  },
  {
    "id": "teams-list-chat-members",
    "description": "List members of a specific chat",
    "examples": [
      "Who is in this chat?",
      "List chat participants",
      "Show members of chat X"
    ],
    "service": "teams",
    "endpoint": "/me/chats/{chat-id}/members",
    "method": "GET",
    "scopes": ["ChatMember.Read", "Chat.ReadBasic"],
    "tags": ["teams", "chats", "members", "list"]
  },
  {
    "id": "teams-get-my-presence",
    "description": "Get the current user's presence status",
    "examples": [
      "What is my status?",
      "Am I showing as available?",
      "Check my presence"
    ],
    "service": "teams",
    "endpoint": "/me/presence",
    "method": "GET",
    "scopes": ["Presence.Read"],
    "tags": ["teams", "presence", "status", "me"]
  },
  {
    "id": "teams-get-user-presence",
    "description": "Get the presence status of a specific user",
    "examples": [
      "Is John online?",
      "What is Sarah's status?",
      "Check if user X is available"
    ],
    "service": "teams",
    "endpoint": "/users/{user-id}/presence",
    "method": "GET",
    "scopes": ["Presence.Read.All"],
    "tags": ["teams", "presence", "status", "user"]
  },
  {
    "id": "teams-get-presence-batch",
    "description": "Get presence status for multiple users at once",
    "examples": [
      "Who on my team is online right now?",
      "Check availability for John, Sarah, and Mike",
      "Get presence for multiple people"
    ],
    "service": "teams",
    "endpoint": "/communications/getPresencesByUserId",
    "method": "POST",
    "scopes": ["Presence.Read.All"],
    "body_template": {
      "ids": ["{{userId1}}", "{{userId2}}", "{{userId3}}"]
    },
    "notes": "Accepts up to 650 user IDs per request. Returns availability and activity for each user.",
    "tags": ["teams", "presence", "status", "batch", "bulk"]
  },
  {
    "id": "teams-update-channel",
    "description": "Update properties of a channel in a team",
    "examples": [
      "Rename the channel to 'New Name'",
      "Update the channel description",
      "Change channel settings"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels/{channel-id}",
    "method": "PATCH",
    "scopes": ["Channel.ReadBasic.All", "ChannelSettings.ReadWrite.All"],
    "body_template": {
      "displayName": "{{newName}}",
      "description": "{{newDescription}}"
    },
    "notes": "The General channel's displayName cannot be changed, but its description can be updated.",
    "tags": ["teams", "channels", "update"]
  },
  {
    "id": "teams-list-channel-members",
    "description": "List members of a specific channel",
    "examples": [
      "Who has access to this channel?",
      "List members of channel X",
      "Show channel participants"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels/{channel-id}/members",
    "method": "GET",
    "scopes": ["ChannelMember.Read.All"],
    "notes": "For standard channels, this returns all team members. For private/shared channels, only members with explicit access.",
    "tags": ["teams", "channels", "members", "list"]
  },
  {
    "id": "teams-create-chat",
    "description": "Create a new one-on-one or group chat",
    "examples": [
      "Start a new chat with John",
      "Create a group chat with John and Sarah",
      "Open a new conversation"
    ],
    "service": "teams",
    "endpoint": "/chats",
    "method": "POST",
    "scopes": ["Chat.Create"],
    "body_template": {
      "chatType": "oneOnOne",
      "members": [
        {
          "@odata.type": "#microsoft.graph.aadUserConversationMember",
          "roles": ["owner"],
          "user@odata.bind": "https://graph.microsoft.com/v1.0/users('{{userId1}}')"
        },
        {
          "@odata.type": "#microsoft.graph.aadUserConversationMember",
          "roles": ["owner"],
          "user@odata.bind": "https://graph.microsoft.com/v1.0/users('{{userId2}}')"
        }
      ]
    },
    "notes": "Use chatType 'oneOnOne' for 1:1 or 'group' for group chats. Group chats can optionally include a topic.",
    "tags": ["teams", "chats", "create"]
  },
  {
    "id": "teams-update-chat",
    "description": "Update a chat's properties such as its topic",
    "examples": [
      "Rename the group chat to 'Project Alpha'",
      "Change the chat topic",
      "Update the group chat name"
    ],
    "service": "teams",
    "endpoint": "/chats/{chat-id}",
    "method": "PATCH",
    "scopes": ["Chat.ReadWrite"],
    "body_template": {
      "topic": "{{newTopic}}"
    },
    "notes": "Only group chats support topics. One-on-one chat topics cannot be set.",
    "tags": ["teams", "chats", "update"]
  },
  {
    "id": "teams-add-chat-member",
    "description": "Add a member to a group chat",
    "examples": [
      "Add John to the group chat",
      "Invite a user to this chat",
      "Add a new participant"
    ],
    "service": "teams",
    "endpoint": "/chats/{chat-id}/members",
    "method": "POST",
    "scopes": ["ChatMember.ReadWrite", "Chat.ReadWrite"],
    "body_template": {
      "@odata.type": "#microsoft.graph.aadUserConversationMember",
      "roles": ["owner"],
      "user@odata.bind": "https://graph.microsoft.com/v1.0/users('{{userId}}')",
      "visibleHistoryStartDateTime": "0001-01-01T00:00:00Z"
    },
    "notes": "Set visibleHistoryStartDateTime to control how far back in chat history the new member can see.",
    "tags": ["teams", "chats", "members", "add", "create"]
  },
  {
    "id": "teams-get-channel-message-delta",
    "description": "Get incremental changes (delta) to messages in a channel",
    "examples": [
      "Get new messages since last check",
      "What messages are new in this channel?",
      "Sync channel messages"
    ],
    "service": "teams",
    "endpoint": "/teams/{team-id}/channels/{channel-id}/messages/delta",
    "method": "GET",
    "scopes": ["ChannelMessage.Read.All"],
    "notes": "ChannelMessage.Read.All may require admin consent in some tenants. Use the deltaLink from a previous response to get only new/changed messages.",
    "tags": ["teams", "channels", "messages", "delta", "sync"]
  },
  {
    "id": "teams-set-my-presence",
    "description": "Set the current user's presence status and activity",
    "examples": [
      "Set my status to busy",
      "Mark me as do not disturb",
      "Change my availability to away"
    ],
    "service": "teams",
    "endpoint": "/me/presence/setPresence",
    "method": "POST",
    "scopes": ["Presence.ReadWrite"],
    "body_template": {
      "sessionId": "{{applicationSessionId}}",
      "availability": "{{availability}}",
      "activity": "{{activity}}",
      "expirationDuration": "PT1H"
    },
    "notes": "availability values: Available, Busy, DoNotDisturb, BeRightBack, Away, Offline. expirationDuration uses ISO 8601 duration format. A unique sessionId per app instance is required.",
    "tags": ["teams", "presence", "status", "set", "update"]
  }
]
