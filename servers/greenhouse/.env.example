# Greenhouse MCP Server — copy this to .env and fill in your values

# Required
GREENHOUSE_CLIENT_ID=your-oauth-client-id
GREENHOUSE_CLIENT_SECRET=your-oauth-client-secret
GREENHOUSE_BOARD_TOKEN=your-board-token-slug

# Your identity (use email OR numeric ID — email will be resolved automatically)
GREENHOUSE_HARVEST_USER_EMAIL=you@company.com
# GREENHOUSE_HARVEST_USER_ID=12345678

# Optional — only needed for specific features
# GREENHOUSE_JOBBOARD_API_KEY=          # for submitting applications via Job Board API
# GREENHOUSE_AUDIT_USER_ID=             # for Audit Log tools
# GREENHOUSE_ONBOARDING_ACCESS_KEY=     # for Greenhouse Onboarding tools
# GREENHOUSE_ONBOARDING_SECRET_KEY=
