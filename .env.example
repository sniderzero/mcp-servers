# OAuth 2.0 credentials (required for OAuth flow)
WRIKE_CLIENT_ID=
WRIKE_CLIENT_SECRET=

# Permanent token (alternative to OAuth)
WRIKE_ACCESS_TOKEN=

# OAuth callback server port (default: 8789)
WRIKE_REDIRECT_PORT=8789

# Wrike API host (default: www.wrike.com, EU: app-eu1.wrike.com)
WRIKE_HOST=www.wrike.com
